# Copier ce fichier en .env et l'adapter. Le fichier .env n'est jamais versionné.
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- LLM ---
# ollama  : modèle local quantifié (développement, aucun quota GPU consommé)
# zerogpu : Space Gradio ZeroGPU sur Hugging Face (production)
# mistral : API Mistral (provisoire) | static : réponse fixe, sans appel externe
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600
LLM_TIMEOUT_S=120

# Ollama (lancé par docker compose, ou en local : http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ministral-3:3b
OLLAMA_NUM_CTX=4096

# ZeroGPU (itération 4 bis)
# HF_TOKEN=
# LLM_SPACE_ID=ton-compte/rag-llm

# Mistral (provisoire)
# MISTRAL_API_KEY=colle-ta-cle-ici
# MISTRAL_MODEL=mistral-small-latest

# --- Recherche ---
RAG_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-m3
HYBRID_SEARCH=true
HYBRID_LEXICAL_WEIGHT=1.0
RETRIEVAL_MIN_SCORE=0.42
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_FETCH_K=20
RETRIEVAL_TOP_K=5
RERANK_MIN_SCORE=0.05
EXCLUDE_OBSOLETE=true

# --- Ingestion (taille choisie par eval/eval_retrieval.py) ---
CHUNK_SIZE=256
CHUNK_OVERLAP=25
CHUNK_MIN_TOKENS=100

# Itération 7
# API_KEYS=
